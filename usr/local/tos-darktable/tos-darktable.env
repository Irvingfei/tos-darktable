# Environment for darktable for TOS.
# Loaded by systemd through EnvironmentFile=/usr/local/tos-darktable/tos-darktable.env
#
# Every path here stays inside the application directory. Nothing the service
# writes goes to a shared system location, so an uninstall can clean up
# completely and an upgrade cannot collide with another application.

# Application identity, used for the platform proxy path and the nginx route.
DTOS_APP_ID=tos-darktable
DTOS_PROXY_PREFIX=/tos-darktable/

# The only network listener. Declared in the submission's permission table.
DTOS_LISTEN_PORT=9312
DTOS_LISTEN_HOST=0.0.0.0

# Runtime data. `data/` and `logs/` are the only trees the service writes to.
DTOS_DATA_DIR=/usr/local/tos-darktable/data
DTOS_LOG_DIR=/usr/local/tos-darktable/logs

# Where the browser-facing frontend is unpacked from webui.bz2 by postinst.
DTOS_WEBUI_DIR=/usr/local/tos-darktable/webui

# Generated location of the access password. Created by postinst with mode
# 0600; the operator reads it once and may change it there.
DTOS_SECRET_FILE=/usr/local/tos-darktable/data/access.txt

# Shared folder where photographs live, created by postinst with the
# platform's own ter_share_add so the File Manager and SMB see it too.
DTOS_SHARE_NAME=darktable-photos
# DTOS_SHARE_ROOT=/Volume1/darktable-photos

# Virtual display geometry. The X server picks the display number itself and
# reports it back, so no number is configured here.
DTOS_SCREEN_WIDTH=1600
DTOS_SCREEN_HEIGHT=1000
DTOS_SCREEN_DEPTH=24

# darktable threads. The platform grants this application 200% CPU; letting
# darktable spawn one worker per host core on a four-bay NAS oversubscribes
# it and makes the interactive session stutter.
DTOS_DT_THREADS=2

# Log levels: DEBUG | INFO | WARN | ERROR.
DTOS_LOG_LEVEL=INFO
