# TOS 7 MarkNest - line ending policy
# Every file consumed by the TOS (Linux) runtime must use LF, never CRLF.
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.ini   text eol=lf
*.lang  text eol=lf
*.service text eol=lf
*.conf  text eol=lf
*.env   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Binary assets keep their bytes untouched.
*.png  binary
*.jpg  binary
*.ico  binary
*.deb  binary
*.bz2  binary
*.gz   binary
*.db   binary
